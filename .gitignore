# 🔴 记忆本体绝不进仓库
buckets/
# Docker 起法的钥匙和网关自己的账（docker-compose.yml 挂的 ./data）
/data/
!buckets/.gitkeep

.env
# A direct install keeps its config.yaml (keys included) in the project root.
/config.yaml
__pycache__/
*.pyc
*.log
.venv/

# 补丁脚本的中间产物，别提交
*.tmp
*.new
*.head

# 网关跑起来之后自己生成的状态和日志（里面是真的记忆内容）
gateway/data/
# The gateway tests' scratch directory. It has a Chinese name and Chinese files
# inside it, so leaving it untracked is not enough — the English ratchet used to
# count it and go red over something that never ships.
gateway/tests/.跑测试留下的东西*/

# Exam runs: reports are per machine and per run; the libraries themselves live in the
# temp dir and are deleted unless --keep.
exam/out/

# The Windows package build output (package/windows/build.py).
/dist/
