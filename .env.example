# ── 必填：打标 / 摘要用的模型（任意 OpenAI 兼容 API）──────────────
LOCI_COMPRESS_API_KEY=
LOCI_COMPRESS_BASE_URL=https://api.deepseek.com/v1
LOCI_COMPRESS_MODEL=deepseek-chat

# ── 必填：向量检索 ────────────────────────────────────────────
# 用本地 ollama：把 base_url 指到 ollama 容器，api_key 随便填
LOCI_EMBED_API_KEY=ollama
LOCI_EMBED_BASE_URL=http://ollama:11434/v1
LOCI_EMBED_MODEL=bge-m3

# ── 选填 ──────────────────────────────────────────────────
# LOCI_TZ=Asia/Shanghai
# LOCI_PORT=8000
# LOCI_MCP_REQUIRE_AUTH=false     # 只在自己内网跑就 false；暴露到公网请开
# AI_NAME=                        # 你的 AI 叫什么

# 从 Ombre-Brain 迁过来的：OMBRE_* 老变量照样认，启动时自动映射成 LOCI_*
